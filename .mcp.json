{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "gcloud": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@google-cloud/gcloud-mcp"]
    },
    "terraform": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server"]
    }
  }
}
