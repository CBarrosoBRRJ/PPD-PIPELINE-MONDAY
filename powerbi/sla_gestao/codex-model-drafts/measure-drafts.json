  {"measureName":"P50EtapaHorasUteis","tableName":"FatoPassagens","expression":"PERCENTILEX.INC(FILTER(FatoPassagens, NOT ISBLANK(FatoPassagens[sla_etapa_horas_uteis])), FatoPassagens[sla_etapa_horas_uteis], 0.5)","status":"Rascunho DAX; validar no Desktop","description":"Mediana de horas úteis observadas por passagem no contexto filtrado","owner":"A pactuar com gestão"},
  {"measureName":"P90EtapaHorasUteis","tableName":"FatoPassagens","expression":"PERCENTILEX.INC(FILTER(FatoPassagens, NOT ISBLANK(FatoPassagens[sla_etapa_horas_uteis])), FatoPassagens[sla_etapa_horas_uteis], 0.9)","status":"Rascunho DAX; validar no Desktop","description":"Percentil 90 de horas úteis observadas por passagem no contexto filtrado","owner":"A pactuar com gestão"},
  {"measureName":"ExposicaoObservadaHorasUteis","tableName":"FatoPassagens","expression":"SUM(FatoPassagens[sla_etapa_horas_uteis])","status":"Rascunho DAX; validar no Desktop","description":"Soma de permanência observada na etapa; não é esforço da equipe","owner":"A pactuar com gestão"},
  {"measureName":"ParticipacaoEtapaExposicao","tableName":"FatoPassagens","expression":"DIVIDE([ExposicaoObservadaHorasUteis], CALCULATE([ExposicaoObservadaHorasUteis], REMOVEFILTERS(FatoPassagens[status_nome])))","status":"Rascunho DAX; validar no Desktop","description":"Participação da etapa dentro da origem e período filtrados; rever se status usar dimensão","owner":"A pactuar com gestão"},
  {"measureName":"CorteDado","tableName":"FatoPassagens","expression":"MAX(FatoPassagens[corte_globocorp_utc])","status":"Rascunho DAX; validar no Desktop","description":"Corte da publicação; observar fuso no cartão","owner":"A pactuar com gestão"},
