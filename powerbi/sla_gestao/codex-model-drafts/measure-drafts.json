  {"measureName":"PassagensKPIEtapa","tableName":"FatoPassagens","expression":"COUNT(FatoPassagens[sla_etapa_horas_uteis])","status":"Rascunho DAX; validar no Desktop","description":"Passagens com duração útil observada elegível no contexto filtrado","owner":"A pactuar com gestão"},
